# AI credentials are server-side only, never shipped to the browser.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# The driver who talks (optional). He uses this machine's Google Cloud login, not a key:
#   gcloud auth application-default login
# with Vertex AI and Cloud Text-to-Speech enabled on the project. All four lines may stay empty.
GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.8-flash
# gemini: an acted voice, a few seconds a line. chirp: a plain French voice, under a second. off: subtitles only.
DRIVER_TTS=gemini
DRIVER_VOICE=Algenib
# How fast he talks: 1 is the voice actor's own idea of it (slow), 1.5 a man in a hurry, 2 the limit.
DRIVER_PACE=1.5

# Google Maps is the default picker and GPS; the city uses the Reconstructed renderer.
# Optional 3D tiles and Street View use this same PUBLIC browser key.
# Enable Maps JavaScript API and Geocoding API; configure billing.
# Restrict the key by HTTP referrer (localhost:5185 for development and your deployed domain).
# It is served at /api/maps/config, so never use a server/AI key here.
GOOGLE_MAPS_BROWSER_KEY=
# Optional map ID, reserved for custom map styles.
GOOGLE_MAPS_MAP_ID=
